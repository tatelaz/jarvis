# Un'unica regola per le righe: LF nel repository (i file venivano scritti da strumenti diversi, misti LF/CRLF).
* text=auto eol=lf
*.bat text eol=crlf
*.png binary
*.wav binary
*.onnx binary
# le informative dell'installatore: Inno Setup le mostra in un riquadro di Windows, che vuole gli a capo CRLF
installer/*.txt text eol=crlf
